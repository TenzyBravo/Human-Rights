# ============================================================================
# HRRAMS — front controller rewrite + security headers + performance
# ============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deliberately NO "RewriteBase". Without it the substitution below is resolved
    # relative to the directory holding this file, so the same rules work whether
    # public/ is the document root or is reached through a subdirectory such as
    # /hrrams/. Hard-coding "RewriteBase /" sends subdirectory installs to the
    # server root's index.php instead of this application's.

    # Uncomment once a TLS certificate is installed.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Serve existing files and directories directly (assets).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Fallback for servers without mod_rewrite.
<IfModule !mod_rewrite.c>
    <IfModule mod_dir.c>
        DirectoryIndex index.php
    </IfModule>
</IfModule>

# No directory listings.
Options -Indexes -MultiViews

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    # Enable with HTTPS only:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
</IfModule>

# GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        text/javascript application/javascript application/json \
        application/xml image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresDefault                        "access plus 1 hour"
</IfModule>

# Never serve dotfiles or backups, whatever the request path.
<FilesMatch "^\.|\.(sql|log|ini|md|bak|swp|dist)$">
    Require all denied
</FilesMatch>

# PHP limits. These directives only exist when PHP runs as an Apache module —
# under FastCGI / PHP-FPM (which is what MAMP uses) an unguarded php_flag is an
# "Invalid command" and Apache answers 500 for every request. Hence the guards.
#
# Running under FastCGI / PHP-FPM? Set these in php.ini instead:
#   display_errors = Off
#   upload_max_filesize = 20M
#   post_max_size = 60M
#   max_file_uploads = 12
<IfModule mod_php.c>
    php_flag display_errors Off
    php_value upload_max_filesize 20M
    php_value post_max_size 60M
    php_value max_file_uploads 12
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_value upload_max_filesize 20M
    php_value post_max_size 60M
    php_value max_file_uploads 12
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_value upload_max_filesize 20M
    php_value post_max_size 60M
    php_value max_file_uploads 12
</IfModule>
